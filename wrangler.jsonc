{
  // parasolv.com — the Parasolv product-family site, served as static assets
  // by a Cloudflare Worker. Same pattern as bermlabs.com (berm-labs repo).
  //
  //   /          family landing (index.html)
  //   /shadow/   Parasolv Shadow
  //   /match/    Parasolv Match
  //   /assets/   shared design system (styles, icon)
  //
  // No build step. Deploy with Workers Builds (connect this repo in the
  // dashboard; the Worker name MUST equal "parasolv" below) or with
  // `npx wrangler deploy`. Paths listed in .assetsignore are never uploaded.
  //
  // DOMAIN: zone routes (not custom_domain) because the zone carries proxied
  // A/CNAME records for @ and www imported from Wix. The Worker intercepts at
  // the edge and the Wix origin is never reached. If those records are ever
  // deleted, switch to {"pattern": "parasolv.com", "custom_domain": true}.
  // Zone added to Cloudflare 2026-09-09; a build that runs before the zone is
  // Active fails on the routes step — just retry it after activation.
  "name": "parasolv",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "parasolv.com/*",     "zone_name": "parasolv.com" },
    { "pattern": "www.parasolv.com/*", "zone_name": "parasolv.com" }
  ]
}
